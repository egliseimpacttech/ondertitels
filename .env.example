# Local development — copy to .env and fill in your keys (never commit .env)
ENV=local

# Offline / VPS inference
LOCAL_INFERENCE=true
LOCAL_WHISPER_MODEL=base
# LOCAL_WHISPER_DEVICE=cpu
# LOCAL_WHISPER_COMPUTE=int8

# Ollama — local OR remote VPS (with Bearer token)
# Local example:
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# Remote VPS example:
OLLAMA_BASE_URL=https://zikolama12.mukadash.net
OLLAMA_TRANSLATE_MODEL=llama3.2:3b
# Paste your reverse-proxy Bearer token here (never commit real tokens)
OLLAMA_API_TOKEN=
# Alias also accepted: OLLAMA_BEARER_TOKEN=

# LOCAL_TRANSLATE_PREFER=ollama
# LOCAL_NLLB_MODEL=facebook/nllb-200-distilled-600M

# Cloud fallbacks (optional)
ELEVENLABS_API_KEY=
DEEPL_API_KEY=
OPENAI_API_KEY=
HUGGINGFACE_API_TOKEN=

LOCAL_INFERENCE=true
OLLAMA_BASE_URL=https://zikolama12.mukadash.net
OLLAMA_TRANSLATE_MODEL=llama3.2:3b
OLLAMA_API_TOKEN=jouw-token
ADMIN_EMAILS=kaat@ondertitels.app
ALLOWED_EMAILS=kaat@ondertitels.app

# Optional
# ELEVENLABS_TTS_API_KEY=
# VOICE_ISOLATION_API_KEY=
# GCS_BUCKET_NAME=
# FIREBASE_PROJECT_ID=ondertitels-1
# ADMIN_EMAILS=you@example.com

# Church subscriptions (configure Stripe Tax and the webhook events documented in README.md)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
APP_BASE_URL=http://127.0.0.1:8000

# Public Firebase Web API key injected into the Vite frontend at build time
VITE_FIREBASE_CONFIG_API_KEY=
